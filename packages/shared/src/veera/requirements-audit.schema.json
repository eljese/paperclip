{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.ing/schemas/veera/requirements-audit-1.0.0.json",
  "title": "Veera requirements-audit",
  "description": "Immutable per-attempt checkpoint result. Stored OUTSIDE the candidate commit (CI/task artifacts). No agent_name field: publisher identity comes from authenticated publication metadata, never from this document.",
  "type": "object",
  "required": [
    "kind",
    "schemaVersion",
    "deliveryId",
    "checkpoint",
    "contractRef",
    "sourceCompleteness",
    "findings"
  ],
  "properties": {
    "kind": { "const": "requirements-audit" },
    "schemaVersion": { "const": "1.0.0" },
    "deliveryId": { "type": "string", "minLength": 1 },
    "checkpoint": { "enum": ["plan", "final"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "contractRef": {
      "type": "object",
      "required": ["deliveryId", "contractHash"],
      "properties": {
        "deliveryId": { "type": "string", "minLength": 1 },
        "contractHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "description": "Required at the final checkpoint: the exact pinned candidate.",
      "required": ["repo", "sha"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "sha": { "$ref": "#/$defs/fullSha" },
        "baseSha": { "$ref": "#/$defs/fullSha" }
      },
      "additionalProperties": false
    },
    "planRef": {
      "type": "object",
      "description": "Required at the plan checkpoint: the exact plan revision approved.",
      "required": ["planRevision", "planHash"],
      "properties": {
        "planRevision": { "type": "string", "minLength": 1 },
        "planHash": { "$ref": "#/$defs/sha256" }
      },
      "additionalProperties": false
    },
    "sourceCompleteness": {
      "type": "object",
      "description": "Direct PRD-vs-contract comparison. Must be explicitly accepted by the independent verifier; anything else is HOLD.",
      "required": ["accepted", "verifierRole"],
      "properties": {
        "accepted": { "type": "boolean" },
        "verifierRole": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "minLength": 1 },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "checkpoint": { "const": "final" } }, "required": ["checkpoint"] },
      "then": { "required": ["candidate"] }
    },
    {
      "if": { "properties": { "checkpoint": { "const": "plan" } }, "required": ["checkpoint"] },
      "then": { "required": ["planRef"] }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fullSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Full 40-char git commit SHA (never abbreviated)."
    },
    "evidence": {
      "type": "object",
      "description": "Required for every PASS finding: req/criterion, source path or artifact, method, outcome, durable ref, candidate/build identity.",
      "required": [
        "requirementId",
        "criterion",
        "sourcePathOrArtifact",
        "method",
        "outcome",
        "durableRef",
        "candidateOrBuildIdentity"
      ],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "criterion": { "type": "string", "minLength": 1 },
        "sourcePathOrArtifact": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "outcome": { "type": "string", "minLength": 1 },
        "durableRef": { "type": "string", "minLength": 1 },
        "candidateOrBuildIdentity": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["requirementId", "result"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "result": { "enum": ["PASS", "PARTIAL", "MISSING", "UNCERTAIN"] },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        },
        "note": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "result": { "const": "PASS" } }, "required": ["result"] },
          "then": { "required": ["evidence"], "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    }
  }
}
